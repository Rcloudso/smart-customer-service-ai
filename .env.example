# Server
PORT=3001
NODE_ENV=development

# LLM 对话模型配置
# 可选：openai / openai-compatible / other
# Provider 和模型名可由管理后台修改；API Base URL 只能由部署环境修改。
LLM_PROVIDER=openai
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
# Secret: inject at runtime; the admin UI and SQLite never store this value.
LLM_API_KEY=
LLM_STREAM_MAX_BYTES=262144

# Embedding 模型配置（独立于 LLM）
# 可选：openai / openai-compatible / other
# 管理后台只显示 API Key 是否已配置，不接收、显示或回写密钥内容。
EMBED_PROVIDER=openai
EMBED_API_BASE=
EMBED_MODEL=text-embedding-3-small
# Secret: inject at runtime; the admin UI and SQLite never store this value.
EMBED_API_KEY=

# Legacy fallback (如果未设置 LLM_API_KEY / OPENAI_MODEL / OPENAI_EMBED_MODEL，仍可用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Authentication
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database
DB_PATH=./data/customer-service.db
DOCUMENT_UPLOAD_DIR=./data/uploads

# Optional vector backend. Memory remains the fresh-clone default. When Qdrant
# is selected, restart the app after changing these deployment values.
VECTOR_STORE_PROVIDER=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=resolveweave_knowledge
QDRANT_COLLECTION_ALIAS=resolveweave_knowledge_active
QDRANT_TIMEOUT_MS=5000
RETRIEVAL_TRACE_RETENTION_DAYS=30

# Optional local PaddleOCR/PP-StructureV3 worker. Existing FAQ/text document
# features keep working when the URL is empty. A matching token is mandatory
# whenever the worker URL is configured.
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=
OCR_ENGINE_VERSION=3.0.3
OCR_TIMEOUT_MS=120000
OCR_BACKGROUND_ENABLED=true
OCR_POLL_INTERVAL_MS=1000

# Optional comparison-only worker. Its output never creates review drafts or
# replaces PaddleOCR authoritative content.
OCR_SHADOW_SERVICE_URL=
OCR_SHADOW_SERVICE_TOKEN=
OCR_SHADOW_ENGINE_VERSION=2.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_CHAT=20
RATE_LIMIT_ADMIN=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_FAQ_SEARCH=60
RATE_LIMIT_ORDER_VERIFY_IP=5
FAQ_SEARCH_MAX_CONCURRENCY=4

# Conversation lifecycle and bounded synchronous export
SESSION_INACTIVITY_MINUTES=30
CONVERSATION_EXPORT_MAX_MESSAGES=5000

# Read-only order status tool. Development/test default to demo; production
# defaults to disabled and must opt in explicitly. Never use demo data as a
# real order-system integration.
# ORDER_TOOL_PROVIDER=demo
ORDER_TOOL_TIMEOUT_MS=3000
ORDER_TOOL_GRANT_TTL_SECONDS=600
